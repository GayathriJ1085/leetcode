import java.util.Scanner;

public class unique {
    public static void main(String [] args){
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int arr[] = new int [a];

        if (a ==0){
            System.out.print(0);
            return;
        }
        for (int i =0; i<a; i++){
            arr[i]= sc.nextInt();
        }

        int sum = 1;
        for (int i =1; i<a; i++){
            if(arr[i]!=arr[i-1]){
                arr[sum]=arr[i];
                sum++;
            }
        }
        System.out.print(sum);

    }
}

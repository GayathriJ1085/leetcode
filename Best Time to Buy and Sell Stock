import java.util.Scanner;

public class best {
    public static void main(String [] args){
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int arr[] = new int [a];

        for (int i =0; i<a; i++){
            arr[i]= sc.nextInt();
        }

        int profit =0;
        for (int i =0; i<a; i++){
            for (int j =i+1; j<a; j++){
                int e = arr[j]-arr[i];

                if( e> profit){
                    profit = e;
                }

            }

        }
        System.out.print(profit);
        }
}

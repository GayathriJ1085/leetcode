import java.util.*;
public class check{
    public static void main(String [] args){
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int arr[] = new int[a];

        for(int i=0; i<a; i++){
            arr[i]= sc.nextInt();
        }

        boolean bla = false;
        int j =1;
        for(int i=0; i<a; i++){
            while  (j<a){
                if (arr[i]==arr[j]){
                bla = true;
                }
            j++;
            }
        }
        System.out.print(bla);
    }

}
